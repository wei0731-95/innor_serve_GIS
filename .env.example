# 專案根目錄環境變數範例。
# - 本機開發（npm run dev）：複製成 .env.development，Vite 只讀取 VITE_ 開頭的變數。
# - Docker：複製成 .env（已 gitignore），docker compose 會自動讀取並覆寫 docker-compose.yml 的 ${VAR:-預設值}。
#   注意 Vite 也會讀取根目錄的 .env，所以其中的 VITE_API_BASE_URL 會同時影響本機 dev 與 Docker build。

# ---------- 前端 ----------
# 後端 API 位址（Vite build-time 變數，於瀏覽器端 fetch 使用）。
# - 本機 dev 未設定時預設 http://localhost:8000
# - Docker 預設空字串：瀏覽器打同源 /api/...，由 nginx 轉給 backend container（不需跨網域 CORS）
# - 前後端不同網域部署時填完整網址，並在後端 CORS_ORIGINS 加入前端網域
VITE_API_BASE_URL=http://localhost:8000

# ---------- Docker Compose（預設值見 docker-compose.yml）----------
# 對外 port。宿主機 8000 / 3000 已被其他程式或 container 占用時在此改掉；container 內的 port 不變。
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# 允許的瀏覽器來源（逗號分隔）。預設含 Docker 前端 3000 與 Vite dev server 5173 / 5174。不要用 *。
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 後端啟動時是否在背景同步政府開放資料
# SYNC_ON_STARTUP=true

# 下載政府資料的逾時（秒）與重試次數
# HTTP_TIMEOUT_SECONDS=90
# HTTP_MAX_RETRIES=2

# 台灣政府主機憑證鏈缺 Subject Key Identifier；false 只關閉 Python 3.13 的嚴格旗標，CA 與主機名稱驗證仍啟用
# SSL_STRICT_X509=false

# LOG_LEVEL=INFO
