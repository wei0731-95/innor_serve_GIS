# 複製成 backend/.env 後依環境調整。backend/.env 已列入 .gitignore，不要提交。

# SQLite 檔案位置（相對路徑以 backend/ 為基準）。第一次啟動會自動建立資料庫與資料表。
DATABASE_URL=sqlite:///./data/citygap.db

# 允許的前端來源（逗號分隔）。開發：Vite dev server；正式環境請填實際網域。
# 不要在正式環境使用 *（詳見 README「CORS」）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 後端啟動時是否自動同步所有啟用的政府資料來源（背景執行，不阻擋 API）。
SYNC_ON_STARTUP=true

# 下載政府資料的逾時（秒）與重試次數。
HTTP_TIMEOUT_SECONDS=90
HTTP_MAX_RETRIES=2

# Python 3.13 預設啟用嚴格 X.509 驗證，會拒絕 data.taipei / stats.moe.gov.tw /
# ltcpap.mohw.gov.tw / tgos.tw 的憑證鏈（缺少 Subject Key Identifier）。
# false = 關閉嚴格模式，但仍保留 CA 與主機名稱驗證。
SSL_STRICT_X509=false

# 下載檔案的本機快取目錄（相對路徑以 backend/ 為基準）。
CACHE_DIR=./data/cache

LOG_LEVEL=INFO
